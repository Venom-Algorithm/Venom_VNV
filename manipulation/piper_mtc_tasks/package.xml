<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>piper_mtc_tasks</name>
  <version>0.1.0</version>
  <description>MoveIt Task Constructor task server for Piper manipulation workflows.</description>
  <maintainer email="liyihan.xyz@gmail.com">venom</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>linkattacher_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>venom_manipulation</depend>
  <depend>venom_manipulation_interfaces</depend>

  <build_depend>moveit_task_constructor_core</build_depend>
  <build_depend>moveit_task_constructor_msgs</build_depend>
  <exec_depend>moveit_task_constructor_core</exec_depend>
  <exec_depend>moveit_task_constructor_msgs</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>piper_gazebo</exec_depend>
  <exec_depend>piper_with_gripper_moveit</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
